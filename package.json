{
  "name": "rpg-maker-mz-mcp",
  "version": "1.0.0",
  "description": "RPG Maker MZ - MCP Ultimate: servidor Model Context Protocol que dá controle total de projetos RPG Maker MZ a agentes de IA",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rpg-maker-mz-mcp": "dist/index.js"
  },
  "author": {
    "name": "Newton Alves"
  },
  "files": [
    "dist",
    "companion-src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-dashboard-public.mjs",
    "build:companion": "node scripts/build-companion.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run build:companion"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "acorn": "^8.12.0",
    "chokidar": "^3.6.0",
    "jimp": "^1.6.1",
    "lz-string": "^1.5.0",
    "papaparse": "^5.4.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rpg-maker-mz",
    "rpgmakermz",
    "rmmz",
    "game-development",
    "ai-agent"
  ]
}
