    { "id": "physical_heavy", "displayName": "Ataque físico pesado", "formula": "a.atk * 6 - b.def * 2", "type": 1, "variance": 25, "critical": true, "description": "Skill lento com muito dano.", "tags": ["physical", "single_target", "heavy", "slow"] },
    { "id": "magical_low", "displayName": "Magia tier 1", "formula": "a.mat * 4 - b.mdf * 2", "type": 1, "variance": 20, "critical": false, "description": "Elemental spell básico.", "tags": ["magical", "single_target", "low_tier", "elemental"], "skillExample": "Fire" },
