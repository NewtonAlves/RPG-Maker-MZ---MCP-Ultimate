    { "id": "magical_high", "displayName": "Magia tier 3 (ultimate)", "formula": "a.mat * 8 - b.mdf * 3", "type": 1, "variance": 20, "critical": false, "description": "Spell ultimate.", "tags": ["magical", "single_target", "high_tier", "ultimate"], "skillExample": "Firaja" },
    { "id": "magical_aoe", "displayName": "Magia em área", "formula": "a.mat * 3 - b.mdf", "type": 1, "variance": 15, "critical": false, "description": "Dano reduzido por ser AoE.", "tags": ["magical", "aoe", "area_effect"], "skillExample": "Fireball" },
    { "id": "drain_hp", "displayName": "Drenar HP (vampírico)", "formula": "a.atk * 2 - b.def", "type": 5, "variance": 20, "critical": false, "description": "Dano físico que restaura HP do user. type=5 (HP Drain).", "tags": ["lifesteal", "physical", "single_target", "healing"], "skillExample": "Blood Suck (id:17)" },
    { "id": "drain_mp", "displayName": "Absorver MP", "formula": "5 + a.mat * 0.2", "type": 6, "variance": 20, "critical": false, "description": "Absorve MP do target.", "tags": ["mp_absorb", "magical"], "skillExample": "Bizarre Dance (id:25)" },
    { "id": "healing_low", "displayName": "Cura básica", "formula": "a.mat * 1.5 + 50", "type": 3, "variance": 0, "critical": false, "description": "Cura baixa.", "tags": ["healing", "recovery", "low_tier"], "skillExample": "Cure" },
    { "id": "healing_medium", "displayName": "Cura média", "formula": "a.mat * 2.5 + 100", "type": 3, "variance": 0, "critical": false, "description": "Cura média.", "tags": ["healing", "recovery", "medium_tier"], "skillExample": "Cura" },
    { "id": "healing_high", "displayName": "Cura massiva", "formula": "a.mat * 3 + 200", "type": 3, "variance": 0, "critical": false, "description": "Cura alta.", "tags": ["healing", "recovery", "high_tier", "expensive"], "skillExample": "Curaga" },
    { "id": "healing_percent", "displayName": "Cura por % HP", "formula": "b.mhp / 4", "type": 3, "variance": 0, "critical": false, "description": "Cura 25% do MaxHP do target.", "tags": ["healing", "recovery", "percent_based"], "skillExample": "Meditate (id:18)" },
    { "id": "fixed_damage", "displayName": "Dano fixo (true damage)", "formula": "100", "type": 1, "variance": 0, "critical": false, "description": "Dano sempre exato. Ignora DEF.", "tags": ["fixed", "true_damage", "special"], "skillExample": "Judgement" },
    { "id": "hp_percent_damage", "displayName": "Dano por % HP máximo", "formula": "b.mhp * 0.3", "type": 1, "variance": 10, "critical": false, "description": "Dano = 30% do MaxHP do target. Bypass DEF.", "tags": ["percent_damage", "hp_based"], "skillExample": "Requiem" },
    { "id": "sacrifice_user", "displayName": "Sacrifício (user perde HP)", "formula": "a.mhp * 0.2", "type": 1, "variance": 10, "critical": false, "description": "Dano baseado no MaxHP do attacker. User perde HP ao usar (via effect).", "tags": ["sacrifice", "hp_cost", "self_damage"], "skillExample": "Mystic Sacrifice" },
    { "id": "scaling_level", "displayName": "Escala com level", "formula": "a.atk * (1 + a.level / 100) - b.def", "type": 1, "variance": 20, "critical": true, "description": "Dano escala com level do user (anti late-game power creep).", "tags": ["scaling", "level_based"] },
    { "id": "agi_based", "displayName": "Baseado em AGI", "formula": "a.agi * 3 - b.def", "type": 1, "variance": 15, "critical": true, "description": "Dano usa AGI ao invés de ATK (skills de assassinos/ladrões).", "tags": ["physical", "agi_based", "ninja", "rogue"] },
    { "id": "low_hp_bonus", "displayName": "Bonus se HP baixo", "formula": "a.atk * (4 + (1 - a.hp / a.mhp) * 4) - b.def * 2", "type": 1, "variance": 25, "critical": true, "description": "Dano cresce conforme HP do user diminui (last stand).", "tags": ["physical", "last_stand", "comeback"] }
  ]
